# Cloudflare Pages / Netlify header rules.
#
# Deliberately NO COOP/COEP. MediaPipe tasks-vision runs single-threaded WASM on
# the GPU delegate and never needs SharedArrayBuffer, while COEP would break the
# ?mp=cdn debugging escape hatch and every third-party overlay iframe we plan to
# embed later. Cross-origin isolation would be cost with no benefit here.

/mediapipe/*
  # Content-addressed by SHA-256 pin and versioned with the dependency, so a
  # stale cache is not a risk worth a revalidation round-trip per launch.
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # These are ALLOW rules, not denials: the app needs the camera for tracking,
  # and display-capture/microphone are what the recording work will use.
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self)
  # Second line of defence for scene embeds. `sanitizeEmbedUrl` is the first,
  # but it is client code — a scene arriving from someone else's link is only
  # ever as trustworthy as the code that parsed it, and that code can be
  # stepped over in devtools. This header cannot. Keep the two lists in sync:
  # src/scene/embeds.ts is the readable copy.
  Content-Security-Policy: frame-src https://*.streamelements.com https://*.streamlabs.com https://www.youtube-nocookie.com https://player.twitch.tv;
