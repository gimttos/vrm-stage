{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vrm-stage",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-28",
	// Static assets and the API ship as one Worker. Only /api/* reaches the
	// script; everything else is served straight from dist/.
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// One Durable Object per broadcast room — the coordination atom here is a
	// room, never a global object.
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		}
	],
	// Viewers render the avatar locally, so they need the VRM itself. 15MB cannot
	// ride the pose channel.
	"r2_buckets": [
		{
			"binding": "MODELS",
			"bucket_name": "vrm-stage-models"
		},
		{
			"bucket_name": "vrm-stage-models",
			"binding": "vrm_stage_models",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}